{
  "name": "cachearoo",
  "scripts": {
    "dev": "cross-env CACHEAROO_RUN_MODE=dev ts-node src/app.ts",
    "start": "node ./build/app/app.js",
    "clean": "node clean.js",
    "build": "npm run clean && npm run build-frontend && npm run build-backend && node copy-assets",
    "build-backend": "tsc",
    "build-frontend": "cd _admin && node build",
    "package-win": "cd build && npm install --production && cd .. && node copy-win-assets && cd setup\\win && make-installer.bat",
    "package-deb": "setup/deb/build-deb.sh",
    "lint": "npm run lint:backend && npm run lint:admin",
    "lint:backend": "eslint src --max-warnings=0",
    "lint:admin": "cd _admin && npm run lint",
    "bench": "npm run build-backend && node -e \"require('fs').copyFileSync('package.json','build/package.json')\" && node bench/event-bus.bench.js",
    "prepackage-win": "npm run build",
    "prepackage-deb": "npm run build",
    "notices": "node scripts/gen-third-party-notices.js",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:md": "node scripts/sbom-report.mjs SBOM.md",
    "compliance": "npm run sbom && npm run sbom:md && npm run notices",    
    "test": "ts-mocha test/**/*.test.ts"
  },
  "description": "Cachearoo - production-grade key/value store with a WebSocket event bus",
  "version": "1.0.10",
  "license": "MIT",
  "author": "Stinky Computing AB",
  "homepage": "https://github.com/stinkydev/cachearoo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/stinkydev/cachearoo.git"
  },
  "bugs": {
    "url": "https://github.com/stinkydev/cachearoo/issues"
  },
  "dependencies": {
    "basic-auth": "^2.0.1",
    "express": "^5.1.0",
    "json-patch": "~0.7.0",
    "level": "^7.0.1",
    "nconf": "^0.12.1",
    "await-semaphore": "^0.1.3",
    "websocket": "^1.0.35",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/nconf": "^0.10.0",
    "@types/node": "^24.0.0",
    "@types/websocket": "^1.0.10",
    "@eslint/js": "^9.0.0",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2"
  }
}
